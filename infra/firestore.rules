rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // The profile list for an account. The email must be the signed-in one, so
    // it cannot be spoofed or go stale.
    match /users/{uid} {
      allow read: if owner(uid);
      allow write: if owner(uid)
        && request.resource.data.keys().hasOnly(['profiles', 'activeId', 'email', 'updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.profiles is list
        && request.resource.data.profiles.size() <= 20;

      // One profile's budget. Only the shape the app writes is accepted.
      match /budgets/{profileId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasOnly([
            'version', 'setupComplete', 'answers', 'buckets', 'bills',
            'incomeEvents', 'plans', 'deposit', 'extraPlanned', 'updatedAt'
          ])
          && request.resource.data.version is int
          && request.resource.data.buckets is list
          && request.resource.data.buckets.size() <= 100
          && request.resource.data.plans is list
          && request.resource.data.plans.size() <= 60;
      }
    }
  }
}
