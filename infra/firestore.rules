rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everything an account owns lives under users/{uid}. Only that signed-in
    // account can read or write it; nothing is readable anonymously.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
